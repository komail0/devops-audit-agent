# Required: your API key. For an OpenAI, Gemini, Groq or Anthropic key this is enough:
# the endpoint and a default model are chosen from the key. Fill in your own value in .env.
LLM_API_KEY=

# Only needed for other OpenAI-compatible providers, or to override the defaults.
LLM_BASE_URL=
LLM_MODEL=

# Optional limits
AGENT_MAX_STEPS=
AGENT_TIMEOUT_SECONDS=
LLM_MIN_INTERVAL_SECONDS=
LLM_CONTEXT_CHARS=
